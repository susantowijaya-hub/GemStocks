base {\n  html {\n    -webkit-tap-highlight-color: transparent;\n    scroll-behavior: smooth;\n    font-family: var(--font-sans);\n  }\n  html.theme-switching *, html.theme-switching *::before, html.theme-switching *::after {\n    transition: none !important;\n  }\n  html.arctic, html:not(.obsidian):not(.parchment) {\n    color-scheme: light;\n  }\n  body, html.arctic body {\n    overscroll-behavior-y: contain;\n    -webkit-overflow-scrolling: touch;\n    background-color: #EDF3FA;\n    color: #151821;\n  }\n  html.obsidian, html.dark {\n    color-scheme: dark;\n  }\n  html.obsidian body, html.dark body {\n    background-color: #080B12;\n    color: #F8FAFC;\n  }\n  html.parchment {\n    color-scheme: light;\n  }\n  html.parchment body {\n    background-color: #F4F0E6;\n    color: #191815;\n  }\n  button, a, select, input {\n    touch-action: manipulation;\n  }\n}\n.ambient-theme-canvas {\n  position: fixed;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background-color: #EDF3FA;\n  background-image: radial-gradient(circle at 12% 8%, rgba(29, 99, 237, 0.22), transparent 44%), radial-gradient(circle at 86% 22%, rgba(56, 189, 248, 0.20), transparent 42%), radial-gradient(circle at 46% 84%, rgba(14, 165, 233, 0.14), transparent 50%);\n}\nhtml.obsidian .ambient-theme-canvas, html.dark .ambient-theme-canvas {\n  background-color: #080B12;\n  background-image: radial-gradient(ellipse 68% 48% at 18% 12%, rgba(245, 158, 11, 0.30), transparent 62%), radial-gradient(ellipse 56% 44% at 84% 24%, rgba(217, 119, 6, 0.22), transparent 60%), radial-gradient(ellipse 64% 52% at 52% 88%, rgba(245, 158, 11, 0.15), rgba(30, 58, 138, 0.24) 55%, transparent 78%);\n}\nhtml.parchment .ambient-theme-canvas {\n  background-color: #F4F0E6;\n  background-image: radial-gradient(circle at 14% 8%, rgba(194, 65, 12, 0.12), transparent 44%), radial-gradient(circle at 86% 20%, rgba(22, 163, 74, 0.10), transparent 44%), radial-gradient(circle at 50% 88%, rgba(180, 148, 92, 0.18), transparent 