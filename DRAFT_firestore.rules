rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // =========================================================================
    // Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string
        && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortfolioPosition(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'symbol', 'name', 'category',
          'units', 'avgCost', 'currentPrice', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'symbol', 'name', 'category',
          'units', 'avgCost', 'currentPrice', 'linkedAssetId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.symbol is string
        && data.symbol.size() >= 1 && data.symbol.size() <= 20
        && data.symbol.matches('^[A-Z0-9._\\-/]+$')
        && data.name is string
        && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string
        && data.category.size() <= 24
        && data.category in ['Equities', 'Crypto', 'Commodities', 'Cash & FX']
        && (data.units is int || data.units is float) && data.units >= 0
        && (data.avgCost is int || data.avgCost is float) && data.avgCost >= 0
        && (data.currentPrice is int || data.currentPrice is float) && data.currentPrice >= 0
        && (!('linkedAssetId' in data) || (
          data.linkedAssetId is string &&
          data.linkedAssetId.size() <= 32 &&
          data.linkedAssetId.matches('^[a-zA-Z0-9_\\-]*$')
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'nfpAlertEnabled', 'preferredCurrency',
          'favoriteAssetIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'nfpAlertEnabled', 'preferredCurrency',
          'favoriteAssetIds', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.nfpAlertEnabled is bool
        && data.preferredCurrency is string
        && data.preferredCurrency.size() <= 8
        && data.preferredCurrency in ['USD', 'EUR', 'GBP', 'JPY', 'IDR', 'SGD', 'AUD']
        && data.favoriteAssetIds is list
        && data.favoriteAssetIds.size() <= 30
        && (data.favoriteAssetIds.size() == 0 || (data.favoriteAssetIds[0] is string && data.favoriteAssetIds[0].size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiBrief(data, userId) {
      return data.keys().hasAll(['ownerId', 'query', 'answer', 'sources', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'query', 'assetSymbol', 'answer', 'sources', 'createdAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.query is string
        && data.query.size() >= 1 && data.query.size() <= 500
        && (!('assetSymbol' in data) || (data.assetSymbol is string && data.assetSymbol.size() <= 24))
        && data.answer is string
        && data.answer.size() >= 1 && data.answer.size() <= 12000
        && data.sources is list
        && data.sources.size() <= 10
        && (data.sources.size() == 0 || (
          data.sources[0] is map &&
          data.sources[0].keys().hasOnly(['title', 'uri']) &&
          data.sources[0].title is string && data.sources[0].title.size() <= 200 &&
          data.sources[0].uri is string && data.sources[0].uri.size() <= 1024
        ))
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection Match Blocks (Exhaustive for firebase-blueprint.json)
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        );

      allow delete: if false;

      match /positions/{positionId} {
        allow get: if isValidId(userId) && isValidId(positionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(positionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPortfolioPosition(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(positionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPortfolioPosition(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'symbol', 'name', 'category', 'units', 'avgCost', 'currentPrice', 'linkedAssetId', 'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(positionId)
          && isOwner(userId);
      }

      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(prefId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPreferences(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(prefId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPreferences(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nfpAlertEnabled', 'preferredCurrency', 'favoriteAssetIds', 'updatedAt'
            ])
          );

        allow delete: if false;
      }

      match /aiBriefs/{briefId} {
        allow get: if isValidId(userId) && isValidId(briefId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(briefId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidAiBrief(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(briefId)
          && isOwner(userId);
      }
    }
  }
}
