  <script>
    const RATES = {
      USD: 1.0,
      EUR: 0.9447,
      GBP: 0.7889,
      JPY: 154.20,
      IDR: 15845.50,
      SGD: 1.3425
    };

    function calcMobFx() {
      const sendAmount = parseFloat(document.getElementById('mob-calc-send').value) || 0;
      const sendCurr = document.getElementById('mob-curr-send').value;
      const getCurr = document.getElementById('mob-curr-get').value;

      const inUSD = sendAmount / RATES[sendCurr];
      const result = inUSD * RATES[getCurr];

      const prefix = getCurr === 'IDR' ? 'Rp ' : (getCurr === 'EUR' ? '€ ' : (getCurr === 'GBP' ? '£ ' : (getCurr === 'JPY' ? '¥ ' : '$ ')));
      const decimals = (getCurr === 'IDR' || getCurr === 'JPY') ? 0 : 2;

      document.getElementById('mob-calc-result').textContent = prefix + result.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      const singleUnitRate = (1 / RATES[sendCurr]) * RATES[getCurr];
      document.getElementById('mob-fx-rate-text').textContent = `1 ${sendCurr} = ${singleUnitRate.toLocaleString('en-US', { maximumFractionDigits: 2 })} ${getCurr}`;
    }

    function swapMobCurrencies() {
      const sendSelect = document.getElementById('mob-curr-send');
      const getSelect = document.getElementById('mob-curr-get');
      const temp = sendSelect.value;
      sendSelect.value = getSelect.value;
      getSelect.value = temp;
      calcMobFx();
    }

    function applyTheme(isDark) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        try { localStorage.setItem('stocks-theme', 'dark'); } catch(e){}
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        try { localStorage.setItem('stocks-theme', 'light'); } catch(e){}
      }
      document.querySelectorAll('#theme-icon').forEach(icon => {
        icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      });
    }

    function initTheme() {
      let isDark = true;
      try {
        const savedTheme = localStorage.getItem('stocks-theme');
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        isDark = savedTheme ? savedTheme === 'dark' : (prefersDark !== false);
      } catch(e) {}
      applyTheme(isDark);

      document.querySelectorAll('#theme-toggle-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const currentIsDark = document.documentElement.classList.contains('dark') && !document.documentElement.classList.contains('light');
          applyTheme(!currentIsDark);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initTheme();
        calcMobFx();
      });
    } else {
      initTheme();
      calcMobFx();
    }
  </script>


