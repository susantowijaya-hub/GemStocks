      // Update Market Analysis
      const badge = document.getElementById("analysis-sentiment-badge");
      badge.textContent = data.sentiment;
      if (data.sentiment === "Bullish") {
        badge.className = "px-3 py-1 rounded-full text-xs font-bold bg-gain-subtle text-gain border border-gain/30";
