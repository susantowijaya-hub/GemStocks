  <script>
    const STORIES = {
      1: {
        publisher: "Reuters",
        time: "8m ago",
        headline: "Federal Reserve Officials Signal Cautious Stance on Further 2026 Rate Reductions",
        body: "Federal Reserve officials reiterated on Tuesday their measured stance toward further monetary policy adjustments, noting that stubborn service inflation and ongoing corporate refinancing require prolonged vigilance.<br><br>Speaking at a financial roundtable in New York, regional governors signaled that while headline disinflation has progressed, resilient consumer spending and firm labor payrolls decrease the urgency for accelerated rate cuts.<br><br>Market swap pricing subsequently adjusted the implied probability of a December rate cut to 56%, driving benchmark 10-year Treasury yields and firming US Dollar exchange rates."
      },
      2: {
        publisher: "Bloomberg",
        time: "24m ago",
        headline: "Bank Indonesia Maintains Benchmark BI-Rate at 6.00% to Shield Rupiah",
        body: "Bank Indonesia decided at its Board of Governors meeting to maintain the benchmark BI-Rate at 6.00%. Governor Perry Warjiyo reaffirmed that monetary strategy is directed toward strengthening the stability of the Rupiah exchange rate against heightened external macro volatility while supporting sustainable economic expansion.<br><br>The central bank also kept deposit facility and lending facility rates stable, emphasizing adequate foreign exchange liquidity."
      },
      3: {
        publisher: "CNBC",
        time: "38m ago",
        headline: "Gold Spot Touches Daily Peak as Geopolitical Hedging Expands",
        body: "Bullion prices advanced to new intraday highs at $2,642 per ounce as geopolitical hedging and strategic reserve reallocation by Asian central banks offset a resilient US Dollar. Technical analysts mark $2,685 as the next structural resistance ceiling."
      },
      4: {
        publisher: "Financial Times",
        time: "1h ago",
        headline: "OPEC+ Considers Extending Voluntary Crude Reductions into Next Quarter",
        body: "Energy delegates reached an informal consensus to extend voluntary crude output curbs through the first quarter of next year, seeking to counterbalance record non-OPEC shale output and secure price stabilization."
      },
      5: {
        publisher: "CoinDesk / Bloomberg",
        time: "2h ago",
        headline: "Bitcoin Holds Above $91,000 on Record Net Spot ETF Inflow Streak",
        body: "Institutional custodians reported aggregate net inflows exceeding $850 million over the past 48 hours, absorbing secondary market supply efficiently and pushing 24h volume above $42 billion."
      }
    };

    function openStory(id) {
      const story = STORIES[id] || STORIES[1];
      document.getElementById("modal-publisher").textContent = story.publisher;
      document.getElementById("modal-time").textContent = story.time;
      document.getElementById("modal-headline").textContent = story.headline;
      document.getElementById("modal-content").innerHTML = `<p>${story.body}</p>`;
      document.getElementById("news-modal").classList.remove("hidden");
    }

    // Category Filtering
    document.querySelectorAll(".topic-filter-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".topic-filter-btn").forEach(b => {
          b.className = "px-3 py-1 rounded-full text-[11px] font-semibold bg-dark-surface-container text-dark-on-surface-variant hover:text-white border border-divider topic-filter-btn whitespace-nowrap";
        });
        btn.className = "px-3 py-1 rounded-full text-[11px] font-semibold bg-dark-primary text-white shadow-sm topic-filter-btn whitespace-nowrap";

        const topic = btn.getAttribute("data-topic");
        document.querySelectorAll(".news-item").forEach(item => {
          if (topic === "all" || item.getAttribute("data-topic") === topic) {
            item.style.display = "flex";
          } else {
            item.style.display = "none";
          }
        });
      });
    });

    // Search filter
    document.getElementById("news-search-input").addEventListener("input", (e) => {
      const q = e.target.value.toLowerCase().trim();
      document.querySelectorAll(".news-item").forEach(item => {
        const text = item.innerText.toLowerCase();
        item.style.display = text.includes(q) ? "flex" : "none";
      });
    });

    // Theme Toggle
    const themeBtn = document.getElementById("theme-toggle-btn");
    const themeIcon = document.getElementById("theme-icon");
    let isDark = true;
    
      // --- Apple iOS Theme Engine (Dark / Light) ---
    function initTheme() {
      const savedTheme = localStorage.getItem('stocks-theme');
      const isDark = savedTheme ? savedTheme === 'dark' : true;
      applyTheme(isDark);
    }

    function applyTheme(isDark) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        localStorage.setItem('stocks-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('stocks-theme', 'light');
      }
      document.querySelectorAll('#theme-icon').forEach(icon => {
        icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      });
    }

    document.querySelectorAll('#theme-toggle-btn, #dock-theme-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const currentDark = !document.documentElement.classList.contains('light');
        applyTheme(!currentDark);
      });
    });

    initTheme();
  </script>


