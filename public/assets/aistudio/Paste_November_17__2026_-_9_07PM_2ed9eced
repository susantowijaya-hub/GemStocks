  <script>
    function applyTheme(isDark) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        try { localStorage.setItem('stocks-theme', 'dark'); } catch(e){}
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        try { localStorage.setItem('stocks-theme', 'light'); } catch(e){}
      }
      document.querySelectorAll('#theme-icon').forEach(icon => {
        icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      });
    }

    function initTheme() {
      let isDark = true;
      try {
        const savedTheme = localStorage.getItem('stocks-theme');
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        isDark = savedTheme ? savedTheme === 'dark' : (prefersDark !== false);
      } catch(e) {}
      applyTheme(isDark);

      const toggleSelectors = ['#theme-toggle-btn', '#theme-toggle', '#dock-theme-toggle'];
      toggleSelectors.forEach(sel => {
        document.querySelectorAll(sel).forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const currentIsDark = document.documentElement.classList.contains('dark') && !document.documentElement.classList.contains('light');
            applyTheme(!currentIsDark);
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTheme);
    } else {
      initTheme();
    }
  
    // ==========================================
    // Dynamic Portfolio Holdings Engine
    // ==========================================
    const DEFAULT_PORTFOLIO = [
      { id: 'pos-1', symbol: 'SPX', name: 'S&P 500 Index', category: 'Equities', units: 12.0, cost: 5120.00, price: 5914.32 },
      { id: 'pos-2', symbol: 'BTC', name: 'Bitcoin', category: 'Crypto', units: 0.45, cost: 62400.00, price: 91450.00 },
      { id: 'pos-3', symbol: 'XAU', name: 'Gold Spot', category: 'Commodities', units: 9.1, cost: 2180.00, price: 2642.80 },
      { id: 'pos-4', symbol: 'IDX', name: 'IHSG (Indonesia)', category: 'Equities', units: 3500.0, cost: 7.24, price: 7.168 },
      { id: 'pos-5', symbol: 'ETH', name: 'Ethereum', category: 'Crypto', units: 1.6, cost: 2650.00, price: 3120.40 }
    ];

    let portfolioPositions = [];

    function loadPortfolio() {
      try {
        const stored = localStorage.getItem('apple-stocks-portfolio');
        if (stored) {
          portfolioPositions = JSON.parse(stored);
        } else {
          portfolioPositions = [...DEFAULT_PORTFOLIO];
        }
      } catch(e) {
        portfolioPositions = [...DEFAULT_PORTFOLIO];
      }
      renderPortfolio();
    }

    function savePortfolioToStorage() {
      try {
        localStorage.setItem('apple-stocks-portfolio', JSON.stringify(portfolioPositions));
      } catch(e) {}
    }

    function renderPortfolio(filterText = '') {
      const tbody = document.querySelector('table tbody');
      if (!tbody) return;

      tbody.innerHTML = '';
      let totalValue = 18420.00; // Cash balance included
      let totalCost = 18420.00;
      let dayGain = 0;

      const filtered = portfolioPositions.filter(p => {
        if (!filterText) return true;
        const q = filterText.toLowerCase();
        return p.symbol.toLowerCase().includes(q) || p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q);
      });

      filtered.forEach(pos => {
        const val = pos.units * pos.price;
        const costBasis = pos.units * pos.cost;
        const pl = val - costBasis;
        const plPercent = costBasis > 0 ? (pl / costBasis) * 100 : 0;
        const isGain = pl >= 0;

        totalValue += val;
        totalCost += costBasis;

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-dark-surface-container-high/40 transition-colors cursor-pointer group';
        tr.title = 'Click to edit position';
        tr.onclick = () => openEditModal(pos.id);

        tr.innerHTML = `
          <td class="py-3 flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-dark-surface-container-high flex items-center justify-center font-bold text-white text-xs">${pos.symbol}</span>
            <div>
              <p class="font-bold text-white group-hover:text-dark-primary transition-colors">${pos.name}</p>
              <p class="text-[10px] text-dark-on-surface-variant">${pos.category} · ${pos.units} Units</p>
            </div>
          </td>
          <td class="py-3 text-right text-white font-medium">${pos.units.toLocaleString()}</td>
          <td class="py-3 text-right text-dark-on-surface-variant">$${pos.cost.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
          <td class="py-3 text-right text-white font-bold">$${pos.price.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
          <td class="py-3 text-right text-white font-bold">$${val.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
          <td class="py-3 text-right">
            <span class="${isGain ? 'text-gain' : 'text-loss'} font-bold">
              ${isGain ? '+' : ''}$${pl.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} (${isGain ? '+' : ''}${plPercent.toFixed(1)}%)
            </span>
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Update KPI Cards
      const netWorthEl = document.getElementById('total-net-worth');
      const unrealizedEl = document.getElementById('unrealized-pl');
      const costEl = document.getElementById('total-cost-basis') || document.querySelector('section.grid > div:nth-child(3) h2');

      const totalPl = totalValue - totalCost;
      const totalPlPercent = totalCost > 0 ? (totalPl / totalCost) * 100 : 0;

      if (netWorthEl) netWorthEl.textContent = '$' + totalValue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
      if (unrealizedEl) {
        const isTotGain = totalPl >= 0;
        unrealizedEl.textContent = (isTotGain ? '+$' : '-$') + Math.abs(totalPl).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        unrealizedEl.className = `font-headline text-3xl font-extrabold tabular-nums ${isTotGain ? 'text-gain' : 'text-loss'}`;
      }
      if (costEl) costEl.textContent = '$' + totalCost.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
    }

    function openAddModal() {
      document.getElementById('modal-title').textContent = 'Add New Position';
      document.getElementById('pos-id').value = '';
      document.getElementById('pos-symbol').value = '';
      document.getElementById('pos-name').value = '';
      document.getElementById('pos-category').value = 'Equities';
      document.getElementById('pos-units').value = '';
      document.getElementById('pos-cost').value = '';
      document.getElementById('pos-price').value = '';
      document.getElementById('delete-pos-btn').classList.add('hidden');
      document.getElementById('position-modal').classList.remove('hidden');
    }

    function openEditModal(posId) {
      const pos = portfolioPositions.find(p => p.id === posId);
      if (!pos) return;
      document.getElementById('modal-title').textContent = 'Edit Position';
      document.getElementById('pos-id').value = pos.id;
      document.getElementById('pos-symbol').value = pos.symbol;
      document.getElementById('pos-name').value = pos.name;
      document.getElementById('pos-category').value = pos.category;
      document.getElementById('pos-units').value = pos.units;
      document.getElementById('pos-cost').value = pos.cost;
      document.getElementById('pos-price').value = pos.price;
      document.getElementById('delete-pos-btn').classList.remove('hidden');
      document.getElementById('position-modal').classList.remove('hidden');
    }

    function closePositionModal() {
      document.getElementById('position-modal').classList.add('hidden');
    }

    function savePosition(e) {
      e.preventDefault();
      const id = document.getElementById('pos-id').value;
      const symbol = document.getElementById('pos-symbol').value.toUpperCase().trim();
      const name = document.getElementById('pos-name').value.trim();
      const category = document.getElementById('pos-category').value;
      const units = parseFloat(document.getElementById('pos-units').value) || 0;
      const cost = parseFloat(document.getElementById('pos-cost').value) || 0;
      const price = parseFloat(document.getElementById('pos-price').value) || 0;

      if (id) {
        // Edit existing
        const idx = portfolioPositions.findIndex(p => p.id === id);
        if (idx !== -1) {
          portfolioPositions[idx] = { id, symbol, name, category, units, cost, price };
        }
      } else {
        // Create new
        const newId = 'pos-' + Date.now();
        portfolioPositions.unshift({ id: newId, symbol, name, category, units, cost, price });
      }

      savePortfolioToStorage();
      renderPortfolio();
      closePositionModal();
    }

    function deleteCurrentPosition() {
      const id = document.getElementById('pos-id').value;
      if (!id) return;
      portfolioPositions = portfolioPositions.filter(p => p.id !== id);
      savePortfolioToStorage();
      renderPortfolio();
      closePositionModal();
    }

    // Attach search and add button listeners
    window.addEventListener('DOMContentLoaded', () => {
      loadPortfolio();
      const addBtn = document.getElementById('add-position-btn');
      if (addBtn) addBtn.onclick = openAddModal;

      const searchInput = document.getElementById('portfolio-search');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          renderPortfolio(e.target.value);
        });
      }
    });

  </script>


