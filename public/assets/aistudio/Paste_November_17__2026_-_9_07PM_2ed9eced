    // --- Tab Switcher Logic ---
    function switchMobileTab(targetId, dockBtn) {
      document.querySelectorAll(".mobile-view-section").forEach(sec => {
        sec.classList.add("hidden");
      });
      const targetSec = document.getElementById(targetId);
      if (targetSec) targetSec.classList.remove("hidden");

      // Update top segmented controller
      document.querySelectorAll(".mobile-section-tab").forEach(tab => {
        if (tab.getAttribute("data-target") === targetId) {
          tab.className = "mobile-section-tab py-1.5 rounded-lg bg-dark-primary text-white shadow-sm text-center";
        } else {
          tab.className = "mobile-section-tab py-1.5 rounded-lg text-dark-on-surface-variant hover:text-white text-center";
        }
      });

      // Update floating dock buttons
      if (dockBtn) {
        document.querySelectorAll(".dock-nav-btn").forEach(btn => {
          btn.className = "dock-pill-item flex flex-col items-center justify-center w-12 h-12 rounded-xl hover:bg-white/10 text-dark-on-surface-variant hover:text-white dock-nav-btn";
        });
        dockBtn.className = "dock-pill-item flex flex-col items-center justify-center w-12 h-12 rounded-xl bg-white/15 text-white dock-nav-btn active";
      }
    }

    document.querySelectorAll(".mobile-section-tab").forEach(tab => {
      tab.addEventListener("click", () => {
        const target = tab.getAttribute("data-target");
        switchMobileTab(target);
      });
    });

    // --- Select Instrument Function ---
    function selectInstrument(ticker) {
      if (!MARKET_DATA[ticker]) return;
      activeTicker = ticker;
      const data = MARKET_DATA[ticker];

      document.querySelectorAll(".watchlist-row").forEach(row => {
        if (row.getAttribute("data-ticker") === ticker) {
          row.classList.add("bg-dark-surface-container", "border-l-2", "border-dark-primary");
        } else {
          row.classList.remove("bg-dark-surface-container", "border-l-2", "border-dark-primary");
        }
      });

      document.getElementById("main-asset-symbol").textContent = data.symbol;
      document.getElementById("main-asset-name").textContent = data.name;
      document.getElementById("main-asset-exchange").textContent = data.exchange;

      const priceFormatted = typeof data.price === 'number' 
        ? (data.symbol === 'BTCUSD' ? '$' + data.price.toLocaleString('en-US', {minimumFractionDigits: 2}) : data.price.toLocaleString('en-US', {minimumFractionDigits: 2}))
        : data.price;
      document.getElementById("main-asset-price").textContent = priceFormatted;

      const deltaEl = document.getElementById("main-asset-delta");
      deltaEl.textContent = data.delta;
      deltaEl.className = data.isPositive ? "font-bold text-xs text-gain tabular-nums" : "font-bold text-xs text-loss tabular-nums";

      const chartLine = document.getElementById("svg-chart-line");
      const chartArea = document.getElementById("svg-chart-area");
      const prevLine = document.getElementById("svg-prev-close-line");
      
      if (chartLine && data.chartSvgPath) {
        chartLine.setAttribute("d", data.chartSvgPath);
        chartLine.setAttribute("stroke", data.isPositive ? "#30D158" : "#FF453A");
      }
      if (chartArea && data.chartSvgArea) {
        chartArea.setAttribute("d", data.chartSvgArea);
        chartArea.setAttribute("fill", data.isPositive ? "url(#chartGradientGain)" : "url(#chartGradientLoss)");
      }
      if (prevLine && data.prevCloseY) {
        prevLine.setAttribute("y1", data.prevCloseY);
        prevLine.setAttribute("y2", data.prevCloseY);
      }

      document.getElementById("stat-open").textContent = data.open;
      document.getElementById("stat-prev-close").textContent = data.prevClose;
      document.getElementById("stat-day-high").textContent = data.dayHigh;
      document.getElementById("stat-day-low").textContent = data.dayLow;
      document.getElementById("stat-volume").textContent = data.volume;
      document.getElementById("stat-avg-vol").textContent = data.avgVol;

      document.getElementById("stat-52w-display").textContent = `${data.w52Low} — ${data.w52High}`;
      document.getElementById("stat-52w-bar").style.width = `${data.w52Pct}%`;

      const badge = document.getElementById("analysis-sentiment-badge");
      badge.textContent = data.sentiment;
      if (data.sentiment === "Bullish") {
        badge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-gain-subtle text-gain border border-gain/30";
      } else if (data.sentiment === "Bearish") {
        badge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-loss-subtle text-loss border border-loss/30";
      } else {
        badge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-dark-surface-container-high text-dark-on-surface-variant border border-divider";
      }

      document.getElementById("analysis-support").textContent = data.support;
      document.getElementById("analysis-support-note").textContent = data.supportNote;
      document.getElementById("analysis-resistance").textContent = data.resistance;
      document.getElementById("analysis-resistance-note").textContent = data.resistanceNote;
      document.getElementById("analysis-commentary").textContent = data.commentary;
    }

    function toggleBadgeMode() {
      isPercentMode = !isPercentMode;
      const label = document.getElementById("badge-toggle-label");
      label.textContent = isPercentMode ? "%" : "Pts";
      const badges = document.querySelectorAll(".change-badge");
      badges.forEach(b => {
        const txt = b.textContent.trim();
        if (isPercentMode) {
          if (txt.includes("+18.20")) b.textContent = "+0.64%";
          else if (txt.includes("+167.46")) b.textContent = "+0.89%";
        } else {
          if (txt.includes("+0.64%")) b.textContent = "+18.20";
          else if (txt.includes("+0.89%")) b.textContent = "+167.46";
        }
      });
    }

    function toggleLivePulseMobile() {
