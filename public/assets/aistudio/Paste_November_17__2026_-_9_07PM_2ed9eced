  <script>
    // Live Countdown Timer
    let totalSeconds = 3 * 3600 + 42 * 60 + 15;
    const countdownEl = document.getElementById("calendar-countdown-timer");
    setInterval(() => {
      if (totalSeconds > 0) {
        totalSeconds--;
        const h = Math.floor(totalSeconds / 3600);
        const m = Math.floor((totalSeconds % 3600) / 60);
        const s = totalSeconds % 60;
        countdownEl.textContent = `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
      }
    }, 1000);

    // Filtering Logic
    let activeDay = "all";
    let activeCurrency = "ALL";
    let activeImpact = "ALL";

    function filterRows() {
      const q = document.getElementById("event-search-input").value.toLowerCase().trim();
      document.querySelectorAll(".calendar-row").forEach(row => {
        const rowDay = row.getAttribute("data-day");
        const rowCur = row.getAttribute("data-currency");
        const rowImp = row.getAttribute("data-impact");
        const rowText = row.innerText.toLowerCase();

        const matchDay = (activeDay === "all" || activeDay === "week") ? true : (rowDay === activeDay);
        const matchCur = (activeCurrency === "ALL" || rowCur === activeCurrency);
        const matchImp = (activeImpact === "ALL") ? true : (activeImpact === "HIGH" ? rowImp === "HIGH" : true);
        const matchSearch = rowText.includes(q);

        if (matchDay && matchCur && matchImp && matchSearch) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
    }

    document.querySelectorAll(".cal-time-tab").forEach(tab => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".cal-time-tab").forEach(t => {
          t.className = "px-4 py-1.5 rounded-md text-xs font-medium text-dark-on-surface-variant hover:text-white cal-time-tab";
        });
        tab.className = "px-4 py-1.5 rounded-md text-xs font-bold bg-dark-surface-container-high text-white cal-time-tab";
        activeDay = tab.getAttribute("data-day");
        filterRows();
      });
    });

    document.getElementById("currency-select").addEventListener("change", (e) => {
      activeCurrency = e.target.value;
      filterRows();
    });

    document.getElementById("impact-select").addEventListener("change", (e) => {
      activeImpact = e.target.value;
      filterRows();
    });

    document.getElementById("event-search-input").addEventListener("input", filterRows);

    // Theme Toggle
    const themeBtn = document.getElementById("theme-toggle-btn");
    const themeIcon = document.getElementById("theme-icon");
    let isDark = true;
    
      // --- Apple iOS Theme Engine (Dark / Light) ---
    function initTheme() {
      const savedTheme = localStorage.getItem('stocks-theme');
      const isDark = savedTheme ? savedTheme === 'dark' : true;
      applyTheme(isDark);
    }

    function applyTheme(isDark) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        localStorage.setItem('stocks-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('stocks-theme', 'light');
      }
      document.querySelectorAll('#theme-icon').forEach(icon => {
        icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      });
    }

    document.querySelectorAll('#theme-toggle-btn, #dock-theme-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const currentDark = !document.documentElement.classList.contains('light');
        applyTheme(!currentDark);
      });
    });

    initTheme();
  </script>



