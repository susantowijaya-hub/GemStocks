    // --- Interactive Chart Crosshair & Tooltip ---
    const chartSvg = document.getElementById("main-chart-svg");
    const crosshairLine = document.getElementById("svg-crosshair-line");
    const crosshairDot = document.getElementById("svg-crosshair-dot");
    const chartTooltip = document.getElementById("chart-tooltip");

    if (chartSvg && crosshairLine && crosshairDot && chartTooltip) {
      chartSvg.addEventListener("mousemove", (e) => {
        const rect = chartSvg.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const normX = Math.max(0, Math.min(x, rect.width));
        const svgX = (normX / rect.width) * 700;

        // Estimate curve Y point via simple cubic approximation
        const t = svgX / 700;
        const svgY = 170 - (t * 130) + Math.sin(t * Math.PI * 2) * 15;

        crosshairLine.setAttribute("x1", svgX);
        crosshairLine.setAttribute("x2", svgX);
        crosshairLine.classList.remove("hidden");

        crosshairDot.setAttribute("cx", svgX);
        crosshairDot.setAttribute("cy", svgY);
        crosshairDot.classList.remove("hidden");

        // Position Tooltip
        chartTooltip.classList.remove("hidden");
        chartTooltip.style.left = `${Math.min(normX + 15, rect.width - 150)}px`;
        chartTooltip.style.top = `20px`;

        // Formulate time & price readout
        const hours = Math.floor(9.5 + t * 6.5);
        const minutes = Math.floor((t * 390) % 60);
        const timeStr = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')} EST`;
        document.getElementById("tooltip-time").textContent = timeStr;

        const data = MARKET_DATA[activeTicker];
        if (typeof data.price === 'number') {
          const simPrice = data.price * (0.99 + (1 - (svgY / 240)) * 0.02);
          document.getElementById("tooltip-price").textContent = simPrice.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        } else {
          document.getElementById("tooltip-price").textContent = data.price;
        }
      });

      chartSvg.addEventListener("mouseleave", () => {
        crosshairLine.classList.add("hidden");
        crosshairDot.classList.add("hidden");
        chartTooltip.classList.add("hidden");
      });
    }

    // --- Segmented Timeframe Switcher ---
    document.querySelectorAll(".timeframe-pill").forEach(pill => {
      pill.addEventListener("click", () => {
        document.querySelectorAll(".timeframe-pill").forEach(p => {
          p.classList.remove("bg-dark-primary", "text-white", "shadow-sm");
          p.classList.add("text-dark-on-surface-variant");
        });
        pill.classList.remove("text-dark-on-surface-variant");
        pill.classList.add("bg-dark-primary", "text-white", "shadow-sm");

        // Subtle chart wiggle effect to mimic dynamic historical curve refresh
        const tf = pill.getAttribute("data-tf");
        const chartLine = document.getElementById("svg-chart-line");
        const chartArea = document.getElementById("svg-chart-area");
        
        let path = "M0,170 Q120,180 250,110 T500,80 T700,40";
        if (tf === "1W") path = "M0,140 Q180,190 350,100 T540,110 T700,30";
        else if (tf === "1M") path = "M0,190 Q200,160 380,80 T560,90 T700,50";
        else if (tf === "3M") path = "M0,160 Q220,130 400,120 T600,60 T700,20";
        else if (tf === "YTD") path = "M0,210 Q240,140 420,90 T600,50 T700,15";
        else if (tf === "1Y") path = "M0,220 Q250,180 440,110 T620,70 T700,10";
        else if (tf === "ALL") path = "M0,230 Q280,190 480,130 T640,60 T700,5";

        const data = MARKET_DATA[activeTicker];
        if (chartLine) {
          chartLine.setAttribute("d", path);
          chartLine.setAttribute("stroke", data.isPositive ? "#30D158" : "#FF453A");
        }
        if (chartArea) {
          chartArea.setAttribute("d", path + " L700,240 L0,240 Z");
          chartArea.setAttribute("fill", data.isPositive ? "url(#chartGradientGain)" : "url(#chartGradientLoss)");
        }
      });
    });

    // --- Live Price Tick Simulation Engine ---
    setInterval(() => {
      if (!isLivePulseActive) return;

      // Random micro tick on active instrument
      const data = MARKET_DATA[activeTicker];
      if (typeof data.price === 'number') {
        const delta = (Math.random() - 0.48) * (data.price * 0.0006);
        data.price = Number((data.price + delta).toFixed(2));
        
        const priceEl = document.getElementById("main-asset-price");
        priceEl.textContent = data.symbol === 'BTCUSD' ? '$' + data.price.toLocaleString('en-US', {minimumFractionDigits: 2}) : data.price.toLocaleString('en-US', {minimumFractionDigits: 2});
        
        // Gentle pulse indicator
        priceEl.classList.add(delta >= 0 ? "text-gain" : "text-loss");
        setTimeout(() => {
          priceEl.classList.remove("text-gain", "text-loss");
        }, 600);
      }

      // Micro tick on random stat tile
      const tickers = ["SPX", "IXIC", "IHSG", "XAUUSD", "BTCUSD", "USDIDR"];
      const randTicker = tickers[Math.floor(Math.random() * tickers.length)];
      const statEl = document.getElementById(`stat-price-${randTicker}`);
      if (statEl) {
        statEl.classList.add("text-gain");
        setTimeout(() => statEl.classList.remove("text-gain"), 400);
      }
    }, 3200);

    // Live Pulse Button Toggle
    const pulseBtn = document.getElementById("live-pulse-btn");
    pulseBtn.addEventListener("click", () => {
      isLivePulseActive = !isLivePulseActive;
      if (isLivePulseActive) {
        pulseBtn.className = "px-3 py-1 rounded-full bg-gain/10 border border-gain/30 text-gain text-xs font-semibold flex items-center gap-1.5 hover:bg-gain/20 transition-all";
        pulseBtn.innerHTML = '<span class="w-2 h-2 rounded-full bg-gain animate-ping"></span><span>Live Pulse</span>';
      } else {
        pulseBtn.className = "px-3 py-1 rounded-full bg-dark-surface-container border border-divider text-dark-on-surface-variant text-xs font-semibold flex items-center gap-1.5 hover:text-white transition-all";
        pulseBtn.innerHTML = '<span class="w-2 h-2 rounded-full bg-dark-on-surface-variant"></span><span>Pulse Paused</span>';
      }
    });

    // --- News Reader Modal Handling ---
    const modal = document.getElementById("news-modal");
    const modalClose = document.getElementById("modal-close-btn");

    const NEWS_CONTENT = {
      "1": {
        publisher: "Reuters",
        time: "8m ago",
        headline: "Federal Reserve Officials Signal Cautious Stance on Further 2026 Rate Reductions",
        body: "Federal Reserve officials reiterated on Tuesday their measured stance toward further monetary policy adjustments, noting that stubborn service inflation and ongoing refinancing of corporate debt require prolonged vigilance. Speaking at a financial roundtable in New York, regional governors signaled that while headline disinflation has occurred across core components, resilient consumer spending and firm labor payrolls decrease the urgency for accelerated rate cuts."
      },
      "2": {
        publisher: "Bloomberg",
        time: "24m ago",
        headline: "Bank Indonesia Maintains BI-Rate at 6.00% to Anchor Rupiah Stability",
        body: "Bank Indonesia decided at its Board of Governors meeting to maintain the benchmark BI-Rate at 6.00%. Governor Perry Warjiyo reaffirmed that monetary strategy is directed toward strengthening the stability of the Rupiah exchange rate against heightened external macro volatility while supporting sustainable economic expansion."
      },
      "3": {
        publisher: "CNBC",
        time: "38m ago",
        headline: "Gold Spot Surges Toward New Peak as Real Yields Contract Globally",
        body: "Bullion prices advanced to new intraday highs at $2,642 per ounce as geopolitical hedging and strategic reserve reallocation by Asian central banks offset a resilient US Dollar. Technical analysts mark $2,685 as the next structural target zone."
      },
      "4": {
        publisher: "Financial Times",
        time: "1h ago",
        headline: "OPEC+ Reaffirms Production Restraint Heading Into Next Quarter",
        body: "Energy delegates reached an informal consensus to extend voluntary crude output curbs through the first quarter of next year, seeking to counterbalance record non-OPEC shale output and secure price stabilization."
      }
    };

    function openNewsModal(newsId) {
      const item = NEWS_CONTENT[newsId] || NEWS_CONTENT["1"];
      document.getElementById("modal-publisher").textContent = item.publisher;
      document.getElementById("modal-time").textContent = item.time;
      document.getElementById("modal-headline").textContent = item.headline;
      document.getElementById("modal-content").innerHTML = `<p>${item.body}</p>`;
      modal.classList.remove("hidden");
    }

    document.querySelectorAll(".news-card, .news-ticker-item").forEach(card => {
      card.addEventListener("click", () => {
        const id = card.getAttribute("data-news-id") || "1";
        openNewsModal(id);
      });
    });

    modalClose.addEventListener("click", () => {
      modal.classList.add("hidden");
    });
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.classList.add("hidden");
    });

    // --- Forex Calendar High Impact Filter ---
    const impactToggle = document.getElementById("high-impact-only-toggle");
    impactToggle.addEventListener("change", (e) => {
      const highOnly = e.target.checked;
      document.querySelectorAll(".event-card").forEach(card => {
        if (highOnly && card.getAttribute("data-impact") !== "high") {
          card.style.display = "none";
        } else {
          card.style.display = "flex";
        }
      });
    });

    // Calendar Time Window Filter
    document.querySelectorAll(".cal-time-filter").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".cal-time-filter").forEach(b => {
          b.className = "px-2.5 py-1 rounded-md text-[11px] font-medium text-dark-on-surface-variant hover:text-white cal-time-filter";
        });
        btn.className = "px-2.5 py-1 rounded-md text-[11px] font-semibold bg-dark-surface-container-high text-white cal-time-filter";
      });
    });

    // --- High Impact Countdown Timer Simulation ---
    let totalSeconds = 3 * 3600 + 42 * 60 + 15;
    const countdownEl = document.getElementById("live-countdown-timer");
    setInterval(() => {
      if (totalSeconds > 0) {
        totalSeconds--;
        const h = Math.floor(totalSeconds / 3600);
        const m = Math.floor((totalSeconds % 3600) / 60);
        const s = totalSeconds % 60;
        countdownEl.textContent = `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
      }
    }, 1000);

    // --- Theme Toggle Switch ---
    const themeBtn = document.getElementById("theme-toggle-btn");
    const themeIcon = document.getElementById("theme-icon");
    let isDark = true;
    

    // Badge toggle mode click
    document.getElementById("badge-toggle-mode").addEventListener("click", toggleBadgeMode);

    function updateDockPulseState() {
      const dockIcon = document.getElementById("dock-pulse-icon");
      const dockLabel = document.getElementById("dock-pulse-label");
      if (isLivePulseActive) {
        dockIcon.className = "material-symbols-outlined text-2xl animate-pulse text-gain";
        dockLabel.textContent = "Pulse ON";
      } else {
        dockIcon.className = "material-symbols-outlined text-2xl text-dark-on-surface-variant";
        dockLabel.textContent = "Paused";
      }
    }

    // Set initial selection
    selectInstrument('SPX');
      // --- Apple iOS Theme Engine (Dark / Light) ---
    function initTheme() {
      const savedTheme = localStorage.getItem('stocks-theme');
      const isDark = savedTheme ? savedTheme === 'dark' : true;
      applyTheme(isDark);
    }

    function applyTheme(isDark) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        localStorage.setItem('stocks-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('stocks-theme', 'light');
      }
      document.querySelectorAll('#theme-icon').forEach(icon => {
        icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      });
    }

    document.querySelectorAll('#theme-toggle-btn, #dock-theme-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const currentDark = !document.documentElement.classList.contains('light');
        applyTheme(!currentDark);
      });
    });

    initTheme();
  
    // ==========================================
    // Real Public WebSocket Market Feed Client
    // ==========================================
    const LiveMarketWS = {
      socket: null,
      reconnectAttempts: 0,
      active: true,
      lastTicks: {},

      init() {
        this.connectBinance();
        this.connectLocalSSE();
      },

      // Connect to real Binance public WebSocket for real-time BTC and ETH ticks
      connectBinance() {
        const streams = ['btcusdt@ticker', 'ethusdt@ticker'];
        const wsUrl = `wss://stream.binance.com:9443/ws/${streams.join('/')}`;

        try {
          this.socket = new WebSocket(wsUrl);

          this.socket.onopen = () => {
            console.log('[WebSocket] Connected to live Binance market stream');
            this.updateStatusBadge('CONNECTED (Live WSS)');
            this.reconnectAttempts = 0;
          };

          this.socket.onmessage = (event) => {
            if (!this.active) return;
            try {
              const data = JSON.parse(event.data);
              // Handle Binance ticker stream
              if (data && data.s) {
                const symbol = data.s; // e.g. BTCUSDT, ETHUSDT
                const currentPrice = parseFloat(data.c);
                const priceChangePercent = parseFloat(data.P);
                const priceChange = parseFloat(data.p);

                if (symbol === 'BTCUSDT') {
                  this.updateAssetDisplay('BTCUSD', currentPrice, priceChangePercent, '$');
                } else if (symbol === 'ETHUSDT') {
                  this.updateAssetDisplay('ETHUSD', currentPrice, priceChangePercent, '$');
                }
              }
            } catch (err) {
              console.error('[WebSocket] Parsing error:', err);
            }
          };

          this.socket.onerror = (err) => {
            console.warn('[WebSocket] Live stream warning:', err);
          };

          this.socket.onclose = () => {
            console.log('[WebSocket] Closed. Attempting reconnect in 3s...');
            if (this.reconnectAttempts < 5) {
              this.reconnectAttempts++;
              setTimeout(() => this.connectBinance(), 3000);
            }
          };
        } catch (e) {
          console.warn('[WebSocket] Direct connection unavailable, falling back to simulated ticks:', e);
        }
      },

      // Connect to local backend Server-Sent Events (SSE) if running via server.js
      connectLocalSSE() {
        if (typeof window !== 'undefined' && window.location.protocol.startsWith('http')) {
          try {
            const evtSource = new EventSource('/api/stream');
            evtSource.onmessage = (event) => {
              try {
                const data = JSON.parse(event.data);
                if (data && data.ticker) {
                  this.updateAssetDisplay(data.ticker, data.price, data.percent);
                }
              } catch(e) {}
            };
            evtSource.onerror = () => {
              evtSource.close();
            };
          } catch(e) {}
        }
      },

      updateStatusBadge(statusText) {
        document.querySelectorAll('#live-pulse-btn, #mobile-pulse-btn').forEach(btn => {
          const textSpan = btn.querySelector('span:last-child');
          if (textSpan) textSpan.textContent = statusText || 'Live Feed';
        });
      },

      updateAssetDisplay(ticker, price, percentChange, currencyPrefix = '') {
        const formattedPrice = currencyPrefix + price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const sign = percentChange >= 0 ? '+' : '';
        const formattedPercent = `${sign}${percentChange.toFixed(2)}%`;

        // Update watchlist rows
        const row = document.querySelector(`[data-ticker="${ticker}"]`);
        if (row) {
          const priceEl = row.querySelector('.price-display');
          const badgeEl = row.querySelector('.change-badge');
          
          if (priceEl) {
            // Flash animation on change
            const isGain = percentChange >= 0;
            priceEl.textContent = formattedPrice;
            priceEl.classList.remove('text-gain', 'text-loss');
            priceEl.classList.add(isGain ? 'text-gain' : 'text-loss');
            setTimeout(() => priceEl.classList.remove('text-gain', 'text-loss'), 800);
          }

          if (badgeEl) {
            badgeEl.textContent = formattedPercent;
            badgeEl.className = `change-badge mt-0.5 inline-flex items-center justify-center min-w-[64px] px-2 py-0.5 rounded-full text-[11px] font-bold tabular-nums transition-colors ${percentChange >= 0 ? 'bg-gain text-on-gain' : 'bg-loss text-white'}`;
          }
        }

        // Update main stage header if active instrument matches
        const mainSymbol = document.getElementById('main-asset-symbol');
        if (mainSymbol && (mainSymbol.textContent === ticker || mainSymbol.textContent.replace('/', '') === ticker)) {
          const mainPrice = document.getElementById('main-asset-price');
          const mainDelta = document.getElementById('main-asset-delta');
          if (mainPrice) mainPrice.textContent = formattedPrice;
          if (mainDelta) {
            mainDelta.textContent = `${sign}${(price * (percentChange / 100)).toFixed(2)} (${formattedPercent})`;
            mainDelta.className = `font-bold text-sm tabular-nums ${percentChange >= 0 ? 'text-gain' : 'text-loss'}`;
          }
        }

        // Update top snapshot tile if exists
        const tilePrice = document.getElementById(`stat-price-${ticker}`);
        if (tilePrice) {
          tilePrice.textContent = formattedPrice;
        }
      }
    };

    // Auto-initialize real market stream
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => LiveMarketWS.init());
    } else {
      LiveMarketWS.init();
    }

  </script>



