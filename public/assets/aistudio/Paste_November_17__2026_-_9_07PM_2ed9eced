  <script>
    // Live Countdown Timer
    let totalSeconds = 3 * 3600 + 42 * 60 + 15;
    const countdownEl = document.getElementById("calendar-countdown-timer");
    setInterval(() => {
      if (totalSeconds > 0) {
        totalSeconds--;
        const h = Math.floor(totalSeconds / 3600);
        const m = Math.floor((totalSeconds % 3600) / 60);
        const s = totalSeconds % 60;
        countdownEl.textContent = `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
      }
    }, 1000);

    // Filtering Logic
    let activeDay = "all";
    let activeCurrency = "ALL";
    let highOnly = false;

    function applyFilters() {
      const q = document.getElementById("calendar-search-input").value.toLowerCase().trim();
      document.querySelectorAll(".calendar-event-card").forEach(card => {
        const cardDay = card.getAttribute("data-day");
        const cardCur = card.getAttribute("data-currency");
        const cardImpact = card.getAttribute("data-impact");
        const cardText = card.innerText.toLowerCase();

        const matchDay = (activeDay === "all" || cardDay === activeDay);
        const matchCur = (activeCurrency === "ALL" || cardCur === activeCurrency);
        const matchImpact = (!highOnly || cardImpact === "HIGH");
        const matchText = (!q || cardText.includes(q));

        card.style.display = (matchDay && matchCur && matchImpact && matchText) ? "flex" : "none";
      });
    }

    // Time window tabs
    document.querySelectorAll(".cal-time-tab").forEach(tab => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".cal-time-tab").forEach(t => {
          t.className = "px-3 py-1 rounded-full text-[11px] font-semibold bg-dark-surface-container text-dark-on-surface-variant hover:text-white border border-divider cal-time-tab whitespace-nowrap";
        });
        tab.className = "px-3 py-1 rounded-full text-[11px] font-semibold bg-dark-primary text-white shadow-sm cal-time-tab whitespace-nowrap";
        activeDay = tab.getAttribute("data-day");
        applyFilters();
      });
    });

    // Currency filter buttons
    document.querySelectorAll(".cur-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".cur-btn").forEach(b => {
          b.className = "px-2 py-0.5 rounded font-bold text-[10px] bg-dark-surface-container text-dark-on-surface-variant cur-btn";
        });
        btn.className = "px-2 py-0.5 rounded font-bold text-[10px] bg-dark-surface-container-high text-white cur-btn";
        activeCurrency = btn.getAttribute("data-cur");
        applyFilters();
      });
    });

    // High impact only toggle
    document.getElementById("mobile-high-only").addEventListener("change", (e) => {
      highOnly = e.target.checked;
      applyFilters();
    });

    // Search input
    document.getElementById("calendar-search-input").addEventListener("input", applyFilters);

    // Theme toggle
    const themeBtn = document.getElementById("theme-toggle-btn");
    const themeIcon = document.getElementById("theme-icon");
    let isDark = true;
    
      // --- Apple iOS Theme Engine (Dark / Light) ---
    function initTheme() {
      const savedTheme = localStorage.getItem('stocks-theme');
      const isDark = savedTheme ? savedTheme === 'dark' : true;
      applyTheme(isDark);
    }

    function applyTheme(isDark) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        localStorage.setItem('stocks-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('stocks-theme', 'light');
      }
      document.querySelectorAll('#theme-icon').forEach(icon => {
        icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      });
    }

    document.querySelectorAll('#theme-toggle-btn, #dock-theme-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const currentDark = !document.documentElement.classList.contains('light');
        applyTheme(!currentDark);
      });
    });

    initTheme();
  </script>


