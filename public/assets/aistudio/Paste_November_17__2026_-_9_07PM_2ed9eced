      SGD: 1.3425
    };

    function calculateFxConversion() {
      const sendAmount = parseFloat(document.getElementById('calc-send-amount').value) || 0;
      const sendCurr = document.getElementById('calc-send-curr').value;
      const getCurr = document.getElementById('calc-get-curr').value;

      // Base conversion via USD
      const inUSD = sendAmount / RATES[sendCurr];
      const result = inUSD * RATES[getCurr];

      const prefix = getCurr === 'IDR' ? 'Rp ' : (getCurr === 'EUR' ? '€ ' : (getCurr === 'GBP' ? '£ ' : (getCurr === 'JPY' ? '¥ ' : '$ ')));
      const decimals = (getCurr === 'IDR' || getCurr === 'JPY') ? 0 : 2;

      document.getElementById('calc-result-display').textContent = prefix + result.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      const singleUnitRate = (1 / RATES[sendCurr]) * RATES[getCurr];
      document.getElementById('fx-rate-summary').textContent = `1 ${sendCurr} = ${singleUnitRate.toLocaleString('en-US', { maximumFractionDigits: 4 })} ${getCurr}`;
    }

    function swapCurrencies() {
      const sendSelect = document.getElementById('calc-send-curr');
      const getSelect = document.getElementById('calc-get-curr');
      const temp = sendSelect.value;
      sendSelect.value = getSelect.value;
      getSelect.value = temp;
      calculateFxConversion();
    }

    function applyTheme(isDark) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        try { localStorage.setItem('stocks-theme', 'dark'); } catch(e){}
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        try { localStorage.setItem('stocks-theme', 'light'); } catch(e){}
      }
      document.querySelectorAll('#theme-icon').forEach(icon => {
        icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      });
    }

    function initTheme() {
      let isDark = true;
      try {
        const savedTheme = localStorage.getItem('stocks-theme');
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        isDark = savedTheme ? savedTheme === 'dark' : (prefersDark !== false);
      } catch(e) {}
      applyTheme(isDark);

      const toggleSelectors = ['#theme-toggle-btn', '#theme-toggle', '#dock-theme-toggle'];
      toggleSelectors.forEach(sel => {
        document.querySelectorAll(sel).forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const currentIsDark = document.documentElement.classList.contains('dark') && !document.documentElement.classList.contains('light');
            applyTheme(!currentIsDark);
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initTheme();
        calculateFxConversion();
      });
    } else {
      initTheme();
      calculateFxConversion();
    }
  </script>


