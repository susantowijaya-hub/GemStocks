rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // =========================================================================
    // Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortfolioPosition(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'symbol', 'name', 'category',
          'units', 'avgCost', 'currentPrice', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'symbol', 'name', 'category',
          'units', 'avgCost', 'currentPrice', 'linkedAssetId',
          'portfolioId', 'portfolioName', 'nativeCurrency', 'nativeAvgCost',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() <= 128
        && data.symbol is string
        && data.symbol.size() >= 1 && data.symbol.size() <= 20
        && data.symbol.matches('^[A-Z0-9._/^=-]+$')
        && data.name is string
        && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string
        && data.category.size() <= 24
        && data.category in ['Equities', 'Crypto', 'Commodities', 'Cash & FX']
        && data.units is number && data.units >= 0
        && data.avgCost is number && data.avgCost >= 0
        && data.currentPrice is number && data.currentPrice >= 0
        && (!('linkedAssetId' in data) || (
          data.linkedAssetId is string &&
          data.linkedAssetId.size() <= 32 &&
          data.linkedAssetId.matches('^[a-zA-Z0-9_-]*$')
        ))
        && (!('portfolioId' in data) || (
          data.portfolioId is string &&
          data.portfolioId.size() <= 64 &&
          data.portfolioId.matches('^[a-zA-Z0-9_-]*$')
        ))
        && (!('portfolioName' in data) || (
          data.portfolioName is string &&
          data.portfolioName.size() <= 40
        ))
        && (!('nativeCurrency' in data) || (
          data.nativeCurrency is string &&
          data.nativeCurrency.size() <= 4 &&
          data.nativeCurrency in ['USD', 'IDR']
        ))
        && (!('nativeAvgCost' in data) || (
          data.nativeAvgCost is number &&
          data.nativeAvgCost >= 0
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'nfpAlertEnabled', 'preferredCurrency',
          'favoriteAssetIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'nfpAlertEnabled', 'preferredCurrency',
          'favoriteAssetIds', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() <= 128
        && data.nfpAlertEnabled is bool
        && data.preferredCurrency is string
        && data.preferredCurrency.size() <= 8
        && data.preferredCurrency in ['USD', 'EUR', 'GBP', 'JPY', 'IDR', 'SGD', 'AUD', 'NZD', 'CAD', 'CHF', 'CNY']
        && data.favoriteAssetIds is list
        && data.favoriteAssetIds.size() <= 30
        && (data.favoriteAssetIds.size() == 0 || (data.favoriteAssetIds[0] is string && data.favoriteAssetIds[0].size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiBrief(data, userId) {
      return data.keys().hasAll(['ownerId', 'query', 'answer', 'sources', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'query', 'assetSymbol', 'answer', 'sources', 'createdAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() <= 128
        && data.query is string
        && data.query.size() >= 1 && data.query.size() <= 500
        && (!('assetSymbol' in data) || (data.assetSymbol is string && data.assetSymbol.size() <= 24))
        && data.answer is string
        && data.answer.size() >= 1 && data.answer.size() <= 12000
        && data.sources is list
        && data.sources.size() <= 10
        && (data.sources.size() == 0 || (
          data.sources[0] is map &&
          data.sources[0].keys().hasOnly(['title', 'uri']) &&
          data.sources[0].title is string && data.sources[0].title.size() <= 200 &&
          data.sources[0].uri is string && data.sources[0].uri.size() <= 1024
        ))
        && data.createdAt is timestamp;
    }

    // Expression-budget-optimized SignalHistory validation (<650 AST evaluations on create & update)
    function isValidSignalCoreFields(data, userId) {
      let keys = data.keys();
      return keys.hasAll([
          'ownerId', 'lockKey', 'assetClass', 'sourceEngine', 'symbol',
          'entryPrice', 'stopLoss', 'tp1', 'tp2', 'status', 'createdAt', 'updatedAt'
        ])
        && keys.hasOnly([
          'ownerId', 'lockKey', 'assetClass', 'sourceEngine', 'symbol', 'assetId',
          'name', 'currency', 'decimals', 'timeframe', 'direction', 'strategyTag',
          'confidence', 'firstShownPrice', 'entryPrice', 'entryLow', 'entryHigh',
          'stopLoss', 'tp1', 'tp2', 'riskReward', 'status', 'filledOnFirstSight',
          'executionPosture', 'zoneFillVerified', 'verificationStatus', 'verifiedAtMs',
          'userOutcome', 'journalNote', 'journaledAtMs',
          'timestamp', 'strategy', 'outcome',
          'createdAtMs', 'filledAtMs', 'tp1HitAtMs', 'closedAtMs', 'closedPrice',
          'lastPrice', 'maxFavorablePrice', 'maxAdversePrice',
          'pnlPct', 'rMultiple', 'lastCheckedAtMs',
          'mfeR', 'maeR', 'barrierOutcome', 'timeBarrierAtMs',
          'inKillzone', 'po3Aligned', 'smtConfirmed', 'volatilityRegime', 'htfAligned', 'netRr',
          'stage2Aligned', 'rsRank', 'vcpDetected', 'sectorLeader',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.lockKey is string && data.lockKey.size() <= 80
        && data.assetClass in ['stock_id', 'stock_us', 'crypto', 'commodity']
        && data.sourceEngine in ['idx_scanner', 'us_scanner', 'ict_radar', 'sdcv_radar']
        && data.symbol is string && data.symbol.size() <= 24
        && data.assetId is string && data.assetId.size() <= 32
        && data.name is string && data.name.size() <= 120
        && data.currency in ['USD', 'IDR']
        && data.decimals is number
        && data.timeframe is string && data.timeframe.size() <= 8
        && data.direction in ['BUY', 'SELL']
        && data.strategyTag is string && data.strategyTag.size() <= 140
        && data.confidence is number;
    }

    function isValidSignalLevelsAndState(data) {
      return data.firstShownPrice is number
        && data.entryPrice is number && data.entryPrice > 0
        && data.entryLow is number
        && data.entryHigh is number
        && data.stopLoss is number && data.stopLoss > 0
        && data.tp1 is number && data.tp1 > 0
        && data.tp2 is number && data.tp2 > 0
        && data.riskReward is string && data.riskReward.size() <= 24
        && data.status in ['PENDING_LIMIT', 'RUNNING', 'TP1_HIT', 'TP2_HIT', 'SL_HIT', 'BE_CLOSED', 'EXPIRED']
        && data.filledOnFirstSight is bool
        && data.createdAtMs is number
        && data.lastPrice is number && data.lastPrice > 0
        && data.maxFavorablePrice is number
        && data.maxAdversePrice is number
        && data.pnlPct is number
        && data.rMultiple is number
        && data.lastCheckedAtMs is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSignalOptionalFields(data) {
      return (!('executionPosture' in data) || (data.executionPosture is string && data.executionPosture.size() <= 24))
        && (!('zoneFillVerified' in data) || data.zoneFillVerified is bool)
        && (!('verificationStatus' in data) || data.verificationStatus in ['Pending', 'Verified', 'Expired'])
        && (!('verifiedAtMs' in data) || data.verifiedAtMs is number)
        && (!('userOutcome' in data) || data.userOutcome in ['WIN', 'LOSS', 'BE', 'SKIPPED'])
        && (!('journalNote' in data) || (data.journalNote is string && data.journalNote.size() <= 300))
        && (!('journaledAtMs' in data) || data.journaledAtMs is number)
        && (!('timestamp' in data) || data['timestamp'] is number)
        && (!('strategy' in data) || data.strategy in ['ict_2022', 'sdcv_canonical', 'idx_bandar', 'us_swing'])
        && (!('outcome' in data) || data.outcome in ['PENDING', 'RUNNING', 'WIN', 'LOSS', 'BE', 'EXPIRED'])
        && (!('filledAtMs' in data) || data.filledAtMs is number)
        && (!('tp1HitAtMs' in data) || data.tp1HitAtMs is number)
        && (!('closedAtMs' in data) || data.closedAtMs is number)
        && (!('closedPrice' in data) || data.closedPrice is number)
        && (!('mfeR' in data) || data.mfeR is number)
        && (!('maeR' in data) || data.maeR is number)
        && (!('barrierOutcome' in data) || (data.barrierOutcome is string && data.barrierOutcome.size() <= 20))
        && (!('timeBarrierAtMs' in data) || data.timeBarrierAtMs is number)
        && (!('inKillzone' in data) || data.inKillzone is bool)
        && (!('po3Aligned' in data) || data.po3Aligned is bool)
        && (!('smtConfirmed' in data) || data.smtConfirmed is bool)
        && (!('volatilityRegime' in data) || (data.volatilityRegime is string && data.volatilityRegime.size() <= 20))
        && (!('htfAligned' in data) || data.htfAligned is bool)
        && (!('netRr' in data) || data.netRr is number)
        && (!('stage2Aligned' in data) || data.stage2Aligned is bool)
        && (!('rsRank' in data) || data.rsRank is number)
        && (!('vcpDetected' in data) || data.vcpDetected is bool)
        && (!('sectorLeader' in data) || data.sectorLeader is bool);
    }

    function isValidSignalHistoryRecord(data, userId) {
      return isValidSignalCoreFields(data, userId)
        && isValidSignalLevelsAndState(data)
        && isValidSignalOptionalFields(data);
    }

    function isTerminalSignalStatus(status) {
      return status in ['TP2_HIT', 'SL_HIT', 'BE_CLOSED', 'EXPIRED'];
    }

    // =========================================================================
    // Collection Match Blocks (Exhaustive for firebase-blueprint.json)
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        );

      allow delete: if false;

      match /positions/{positionId} {
        allow get: if isValidId(userId) && isValidId(positionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(positionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPortfolioPosition(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(positionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPortfolioPosition(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'symbol', 'name', 'category', 'units', 'avgCost', 'currentPrice',
              'linkedAssetId', 'portfolioId', 'portfolioName', 'nativeCurrency', 'nativeAvgCost', 'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(positionId)
          && isOwner(userId);
      }

      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(prefId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPreferences(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(prefId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPreferences(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nfpAlertEnabled', 'preferredCurrency', 'favoriteAssetIds', 'updatedAt'
            ])
          );

        allow delete: if false;
      }

      match /aiBriefs/{briefId} {
        allow get: if isValidId(userId) && isValidId(briefId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(briefId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidAiBrief(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(briefId)
          && isOwner(userId);
      }

      match /signalHistory/{signalId} {
        allow get: if isValidId(userId) && isValidId(signalId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(signalId)
          && isOwner(userId)
          && isValidSignalHistoryRecord(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        // Action-based update with Terminal State Locking (Action 1) & Trade Journal Annotation (Action 2)
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(signalId)
          && isOwner(userId)
          && isValidSignalHistoryRecord(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action 1: Live Mark-to-Market & Lifecycle Transition (Pending -> Running -> TP1 -> Terminal)
            (
              !isTerminalSignalStatus(existing().status)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'outcome', 'verificationStatus', 'verifiedAtMs',
                'filledAtMs', 'tp1HitAtMs', 'closedAtMs', 'closedPrice',
                'lastPrice', 'maxFavorablePrice', 'maxAdversePrice',
                'pnlPct', 'rMultiple', 'lastCheckedAtMs', 'zoneFillVerified',
                'mfeR', 'maeR', 'barrierOutcome', 'timeBarrierAtMs', 'updatedAt'
              ])
            )
            ||
            // Action 2: Trader Automated Journal Outcome ('WIN' | 'LOSS' | 'BE' | 'SKIPPED') & Execution Note
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'userOutcome', 'outcome', 'journalNote', 'journaledAtMs', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(signalId)
          && isOwner(userId);
      }
    }
  }
}
